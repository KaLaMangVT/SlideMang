{
  "name": "slidemang",
  "productName": "SlideMang",
  "version": "2.0.1",
  "description": "Controller + OBS display windows with built-in network server",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.slidemang",
    "productName": "SlideMang",
    "files": [
      "main.js",
      "preload-window.js",
      "preload-launcher.js",
      "src/**",
      "web/**",
      "launcher/**",
      "defaults/**",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ], "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SlideMang.exe"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}